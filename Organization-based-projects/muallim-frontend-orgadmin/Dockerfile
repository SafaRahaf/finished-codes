FROM node:20-alpine AS build

WORKDIR /usr/src/app

# COPY package*.json ./


COPY . .

RUN npm install

ARG CORE_API_URL
ENV NEXT_PUBLIC_CORE_API_URL=$CORE_API_URL

ARG FILE_UPLOAD_API_URL
ENV NEXT_PUBLIC_FILE_UPLOAD_API_URL=$FILE_UPLOAD_API_URL

ARG FILE_BROWSE_URL
ENV NEXT_PUBLIC_FILE_BROWSE_URL=$FILE_BROWSE_URL


RUN npm run build



EXPOSE 3000
CMD ["npm", "start"]